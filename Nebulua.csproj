<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Use Exe type to make console available. Lua print() will appear there. -->
        <OutputType>Exe</OutputType>
        <!-- <OutputType>WinExe</OutputType> -->
        <UseWindowsForms>true</UseWindowsForms>
        <OutputPath>bin\</OutputPath>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Platforms>AnyCPU;x64</Platforms>

        <ApplicationIcon>marks.ico</ApplicationIcon>
        <Version>2.0.0</Version>
        <AssemblyName>Nebulua</AssemblyName>
        <RootNamespace>Nebulua</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>CA1816;CA1822;IDE0040</NoWarn>
        <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
        <Company>Ephemera Inc</Company>
        <Product>Nebulua</Product>
        <Description>Play music with lua.</Description>
        <Copyright>MIT License</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="LBOT\**" />
        <Compile Remove="lib\**" />
        <Compile Remove="Interop\**" />
        <Compile Remove="Test\**" />
        <EmbeddedResource Remove="LBOT\**" />
        <EmbeddedResource Remove="lib\**" />
        <EmbeddedResource Remove="Interop\**" />
        <EmbeddedResource Remove="Test\**" />
        <None Remove="LBOT\**" />
        <None Remove="lib\**" />
        <None Remove="Interop\**" />
        <None Remove="Test\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="NAudio" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Ephemera.NBagOfTricks">
            <HintPath>lib\Ephemera.NBagOfTricks.dll</HintPath>
        </Reference>
        <Reference Include="Ephemera.NBagOfUis">
            <HintPath>lib\Ephemera.NBagOfUis.dll</HintPath>
        </Reference>
        <Reference Include="Ephemera.MidiLib">
            <HintPath>lib\Ephemera.MidiLib.dll</HintPath>
        </Reference>
        <Reference Include="Ephemera.MusicLib">
            <HintPath>lib\Ephemera.MusicLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Interop\Interop.vcxproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>